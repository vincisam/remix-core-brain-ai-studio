# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Additional AI Provider Keys (for other engines)
OPENAI_API_KEY="MY_OPENAI_API_KEY"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
GROQ_API_KEY="MY_GROQ_API_KEY"
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"
DASHSCOPE_API_KEY="MY_DASHSCOPE_API_KEY"
COHERE_API_KEY="MY_COHERE_API_KEY"
PERPLEXITY_API_KEY="MY_PERPLEXITY_API_KEY"
XAI_API_KEY="MY_XAI_API_KEY"
ZHIPU_API_KEY="MY_ZHIPU_API_KEY"
STABILITY_API_KEY="MY_STABILITY_API_KEY"
TENCENT_SECRET_ID="MY_TENCENT_SECRET_ID"
TENCENT_SECRET_KEY="MY_TENCENT_SECRET_KEY"

# --- Authentication ---------------------------------------------------------
# JWT_SECRET: signs session tokens issued at signup/login. Set a long random
# string in production; falls back to a dev default if unset.
JWT_SECRET="change_this_to_a_long_random_string"

# Google OAuth ("Continue with Google"). Create credentials at
# https://console.cloud.google.com/apis/credentials and add
# {APP_URL}/api/auth/oauth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth ("Continue with GitHub"). Create an OAuth App at
# https://github.com/settings/developers and set the callback URL to
# {APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
